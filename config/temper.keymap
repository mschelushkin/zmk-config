#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define _BT_0_    &bt BT_SEL 0
#define _BT_1_    &bt BT_SEL 1
#define _BT_2_    &bt BT_SEL 2
#define _BT_3_    &bt BT_SEL 3
#define _BT_4_    &bt BT_SEL 4
#define _BT_CL_A_ &bt BT_CLR_ALL
#define _SFT_SPC_ &mt LSHFT SPACE
#define _SFT_RET_ &mt LSHFT RET

&mt {
    tapping-term-ms = <201>;
    flavor = "tap-preferred";
 };
&lt {
    tapping-term-ms = <201>;
    flavor = "tap-preferred";
 };

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
//   Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  
//   A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  
//   Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  | / (hold BT)
//            | ESC | TAB/LWR | SPC/SFT |   | ENT/SFT | TAB/RSE | BSPC |
                        bindings = <
//      ╭───────────────────────────────────────────────────────────╮   ╭───────────────────────────────────────────────────────────╮
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
            &kp Q       &kp W       &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O       &kp P   
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
       &mt LSHIFT A    &mt LCTRL S  &mt LALT D  &mt LGUI F     &kp G          &kp H    &mt RGUI J  &mt RALT K  &mt RCTRL L  &mt LSHIFT SEMI  
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
            &kp Z       &kp X       &kp C       &kp V       &kp B           &kp N       &kp M     &kp COMMA    &kp DOT    &lt 3 FSLH
//      ╰───────────┼───────────┼───────────┼───────────┼───────────╯   ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                  &kp ESC      &lt 1 TAB     _SFT_SPC_        _SFT_RET_     &lt 2 TAB      &kp BSPC
//                              │                                   │   │                                   │
//                              ╰───────────────────────────────────╯   ╰───────────────────────────────────╯
//
              >;
      };
      lower_layer {
// -----------------------------------------------------------------------------------------
//   !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  
//   1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  
//      |     |     |     |     |   |  _  |  +  |  {  |  }  | PIPE
//                    | transparent thumbs |
                        bindings = <
//      ╭───────────────────────────────────────────────────────────╮   ╭───────────────────────────────────────────────────────────╮
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
           &kp EXCL    &kp AT     &kp HASH    &kp DLLR    &kp PRCNT       &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR  
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
           &kp N1      &kp N2      &kp N3      &kp N4      &kp N5          &kp N6      &kp N7      &kp N8      &kp N9      &kp N0  
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
           &trans      &trans      &trans      &trans      &trans         &kp UNDER   &kp PLUS     &kp LBRC    &kp RBRC    &kp PIPE
//      ╰───────────┼───────────┼───────────┼───────────┼───────────╯   ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                   &trans      &trans      &trans          &trans      &trans      &trans
//                              │                                   │   │                                   │
//                              ╰───────────────────────────────────╯   ╰───────────────────────────────────╯
              >;
      };
                raise_layer {
// -----------------------------------------------------------------------------------------
//  F1  | F7  |     |     |     |   |  "  |  '  |  `  |  ~  | (transparent)
//  F2  | F3  | F4  | F5  | F6  |   | LFT | DWN |  UP | RGT |
//  F8  | F9  | F10 | F11 | F12 |   |  -  |  =  |  [  |  ]  | BSLH
// Corne positions preserved for F2-F6 and F8-F12; F1/F7 replace the missing outer column.
//                    | transparent thumbs |
                        bindings = <
//      ╭───────────────────────────────────────────────────────────╮   ╭───────────────────────────────────────────────────────────╮
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
           &kp F1      &kp F7      &trans     &trans       &trans         &kp DQT     &kp SQT     &kp GRAVE   &kp TILDE   &trans
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │      _    │     _     │     _     │     _     │
           &kp F2      &kp F3      &kp F4      &kp F5      &kp F6          &kp LEFT    &kp DOWN     &kp UP     &kp RIGHT   &trans
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
          &kp F8      &kp F9      &kp F10     &kp F11     &kp F12         &kp MINUS    &kp EQUAL   &kp LBKT    &kp RBKT   &kp BSLH
//      ╰───────────┼───────────┼───────────┼───────────┼───────────╯   ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                   &trans      &trans      &trans          &trans      &trans      &trans
//                              │                                   │   │                                   │
//                              ╰───────────────────────────────────╯   ╰───────────────────────────────────╯
                        >;
                };

                bluetooth_layer {
                        // Hold the base-layer slash key to access Bluetooth controls.
                        // Profiles 0-4 on A-G; clear all bonds on Z.
                        bindings = <
                            &trans      &trans      &trans      &trans      &trans         &trans      &trans      &trans      &trans      &trans
                            _BT_0_      _BT_1_      _BT_2_      _BT_3_      _BT_4_         &trans      &trans      &trans      &trans      &trans
                            _BT_CL_A_   &trans      &trans      &trans      &trans         &trans      &trans      &trans      &trans      &trans
                                        &trans      &trans      &trans         &trans      &trans      &trans
                        >;
                };
        };
};
 
//                                  Template for new layers all keys are transparent
//      ╭───────────────────────────────────────────────────────────╮   ╭───────────────────────────────────────────────────────────╮
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
//      │    ___    │    ___    │    ___    │    ___    │    ___    │   │    ___    │    ___    │    ___    │    ___    │    ___    │
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
//      │    ___    │    ___    │    ___    │    ___    │    ___    │   │    ___    │    ___    │    ___    │    ___    │    ___    │
//      ├───────────┼───────────┼───────────┼───────────┼───────────┤   ├───────────┼───────────┼───────────┼───────────┼───────────┤
//      │     _     │     _     │     _     │     _     │     _     │   │     _     │     _     │     _     │     _     │     _     │
//      │    ___    │    ___    │    ___    │    ___    │    ___    │   │    ___    │    ___    │    ___    │    ___    │    ___    │
//      ╰───────────┼───────────┼───────────┼───────────┼───────────╯   ╰───────────┼───────────┼───────────┼───────────┼───────────╯
//                                   ___         ___              ___         ___
//                              │                                   │   │                                   │
//                              ╰───────────────────────────────────╯   ╰───────────────────────────────────╯
//
